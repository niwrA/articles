{
  "routes": [
    {
      "route": "/artikelen/ai-kan-winnen-terwijl-de-ai-zeepbel-barst",
      "redirect": "/artikelen/ai-zeepbel-of-infrastructuurzeepbel",
      "statusCode": 301
    },
    {
      "route": "/_nuxt/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/index.html",
      "redirect": "/"
    }
  ],
  "globalHeaders": {
    "Cache-Control": "no-cache, max-age=0, must-revalidate"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}
